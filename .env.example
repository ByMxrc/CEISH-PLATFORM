# ============================================================
# CEISH Platform - Variables de Entorno (Ejemplo)
# Copiar este archivo como .env y ajustar los valores
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
# Nota: Si ya tienes PostgreSQL instalado localmente en el puerto 5432,
# usa 5433 (o cualquier otro puerto libre) para el contenedor Docker.
POSTGRES_PORT=5433
POSTGRES_DB=ceish_db
POSTGRES_USER=ceish_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Prisma ---
DATABASE_URL="postgresql://ceish_user:CHANGE_ME@localhost:5433/ceish_db?schema=public"

# --- MinIO ---
MINIO_ROOT_USER=ceish_minio
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=ceish-documents
MINIO_USE_SSL=false

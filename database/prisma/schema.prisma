// ============================================================
// CEISH Platform - Prisma Schema
// ============================================================
// Base de datos: PostgreSQL 15
// ORM: Prisma 5
//
// Grupos de modelos:
//   1. Identidad y perfiles
//   2. Investigaciones y participantes
//   3. Tipos de investigación
//   4. Anexos y versiones (sistema de plantillas)
//   5. Estratificación de riesgo
//   6. Asignaciones y conflictos
//   7. Evaluaciones
//   8. Observaciones y correcciones
//   9. Documentos
//  10. Auditoría / workflow events
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

/// Tipos de usuario del sistema
enum UserType {
  INVESTIGATOR
  CEISH_MEMBER
  ADMIN
}

/// Clasificación de investigador
enum InvestigatorType {
  INTERNAL
  EXTERNAL
}

/// Clasificación de miembro CEISH
enum CeishMemberType {
  INTERNAL // puede estratificar y evaluar
  EXTERNAL // solo puede evaluar
}

/// Estados de la cuenta de usuario
enum UserAccountStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

/// Estados de la investigación (máquina de estados completa)
enum InvestigationStatus {
  CREATED
  PENDING_ADMIN_REVIEW
  REJECTED
  APPROVED
  WAITING_STRATIFICATION
  STRATIFICATION
  RISK_DEFINED
  ADMIN_RISK_REVIEW
  RESTRATIFICATION
  WAITING_EVALUATORS
  WAITING_CONFLICT_CHECK
  UNDER_EVALUATION
  WAITING_RESEARCHER_RESPONSE
  FINAL_REVIEW
  COMPLETED
  CANCELLED
}

/// Niveles de riesgo determinados en estratificación
enum RiskLevel {
  NO_RISK
  MINIMUM_RISK
  GREATER_THAN_MINIMUM_RISK
}

/// Estados del proceso de estratificación
enum RiskAssessmentStatus {
  ACTIVE
  REPLACED
  COMPLETED
}

/// Estados de asignación de evaluador
enum EvaluationAssignmentStatus {
  PENDING
  ACTIVE
  CONFLICT
  REMOVED
  FINISHED
}

/// Estados del proceso de evaluación
enum EvaluationProcessStatus {
  CREATED
  IN_PROGRESS
  OBSERVATIONS_FOUND
  APPROVED
  REJECTED
}

/// Estados de una evaluación individual
enum EvaluationStatus {
  CREATED
  IN_PROGRESS
  OBSERVATIONS_FOUND
  APPROVED
  REJECTED
}

/// Estados del ciclo de corrección
enum CorrectionRoundStatus {
  OPEN
  SUBMITTED
  EXPIRED
  APPROVED
  REJECTED
}

/// Tipos de campo dentro de un anexo
enum AnnexFieldType {
  TEXT
  TEXTAREA
  CHECKLIST
  DATE
  NUMERIC
  FILE_UPLOAD
}

/// Tipos de documento almacenado
enum DocumentType {
  ANNEX_UPLOAD       // archivo subido como parte de un anexo
  CONFLICT_DECLARATION // declaración de conflicto de interés
  CORRECTION_RESPONSE  // corrección enviada por investigador
  EVALUATION_EVIDENCE  // evidencia adjunta a evaluación
  OTHER
}

/// Tipo de evento para auditoría
enum WorkflowEventType {
  USER_REGISTERED
  USER_APPROVED
  USER_REJECTED
  INVESTIGATION_CREATED
  INVESTIGATION_SUBMITTED
  INVESTIGATION_APPROVED
  INVESTIGATION_REJECTED
  STRATIFICATION_CREATED
  STRATIFICATION_REPLACED
  STRATIFICATION_COMPLETED
  RISK_DEFINED
  EVALUATOR_ASSIGNED
  CONFLICT_DECLARED
  EVALUATOR_REMOVED
  EVALUATION_STARTED
  EVALUATION_COMPLETED
  OBSERVATION_ADDED
  CORRECTION_ROUND_OPENED
  CORRECTION_SUBMITTED
  CORRECTION_APPROVED
  CORRECTION_REJECTED
  INVESTIGATION_COMPLETED
  INVESTIGATION_CANCELLED
  ADMIN_ACTION
  REESTRATIFICATION_REQUESTED
}

// ============================================================
// 1. IDENTIDAD Y PERFILES
// ============================================================

/// Usuarios del sistema (todas las personas con acceso)
model User {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  passwordHash  String            @map("password_hash")
  userType      UserType          @map("user_type")
  accountStatus UserAccountStatus @default(PENDING_APPROVAL) @map("account_status")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  // Perfiles específicos por tipo
  investigatorProfile  InvestigatorProfile?
  ceishMemberProfile   CeishMemberProfile?

  // Investigaciones creadas por este usuario
  investigationsCreated Investigation[] @relation("InvestigationCreator")

  // Estratificaciones como creador
  riskAssessmentsCreated RiskAssessment[] @relation("RiskAssessmentCreator")

  // Participación en estratificaciones
  riskAssessmentMembers RiskAssessmentMember[]

  // Asignaciones como evaluador
  evaluationAssignments EvaluationAssignment[]

  // Evaluaciones realizadas
  evaluations Evaluation[]

  // Eventos de auditoría generados por este usuario
  workflowEvents WorkflowEvent[]

  @@map("users")
}

/// Información adicional del investigador
model InvestigatorProfile {
  id               String           @id @default(cuid())
  userId           String           @unique @map("user_id")
  investigatorType InvestigatorType @map("investigator_type")
  identificationNumber String?       @unique @map("identification_number")
  identificationVerifiedAt DateTime? @map("identification_verified_at")
  institution      String?          // institución a la que pertenece
  department       String?          // departamento/facultad
  phone            String?
  createdAt        DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("investigator_profiles")
}

/// Información adicional del miembro CEISH
model CeishMemberProfile {
  id             String          @id @default(cuid())
  userId         String          @unique @map("user_id")
  memberType     CeishMemberType @map("member_type")
  specialization String?         // área de especialización
  institution    String?
  phone          String?
  createdAt      DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("ceish_member_profiles")
}

// ============================================================
// 2. TIPOS DE INVESTIGACIÓN
// ============================================================

/// Catálogo de tipos de investigación (administrable)
model ResearchType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  investigations Investigation[]

  @@map("research_types")
}

// ============================================================
// 3. INVESTIGACIONES Y PARTICIPANTES
// ============================================================

/// Investigaciones presentadas al CEISH
model Investigation {
  id             String              @id @default(cuid())
  code           String?             @unique // CEISH-001, generado al aprobar
  title          String
  description    String?
  status         InvestigationStatus @default(CREATED)
  researchTypeId String              @map("research_type_id")
  createdById    String              @map("created_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  researchType ResearchType @relation(fields: [researchTypeId], references: [id])
  createdBy    User         @relation("InvestigationCreator", fields: [createdById], references: [id])

  // Investigadores participantes (personas, no necesariamente usuarios del sistema)
  participants InvestigationParticipant[]

  // Anexos asociados a esta investigación
  investigationAnnexes InvestigationAnnex[]

  // Procesos de estratificación (historial completo)
  riskAssessments RiskAssessment[]

  // Proceso de evaluación
  evaluationProcess EvaluationProcess?

  // Documentos
  documents Document[]

  // Auditoría
  workflowEvents WorkflowEvent[]

  @@map("investigations")
}

/// Investigadores participantes en una investigación
/// No son necesariamente usuarios del sistema
model InvestigationParticipant {
  id              String   @id @default(cuid())
  investigationId String   @map("investigation_id")
  name            String
  identification  String   // cédula u otro identificador
  email           String?
  role            String?  // rol dentro de la investigación
  institution     String?
  isPrincipal     Boolean  @default(false) @map("is_principal")
  createdAt       DateTime @default(now()) @map("created_at")

  investigation Investigation @relation(fields: [investigationId], references: [id])

  @@map("investigation_participants")
}

// ============================================================
// 4. SISTEMA DE ANEXOS Y VERSIONES
// ============================================================

/// Plantilla de anexo (administrable por el admin)
/// Ej: Anexo 12, Anexo 23, Anexo 27
model AnnexTemplate {
  id          String   @id @default(cuid())
  name        String   @unique // "Anexo 12", "Anexo 23", etc.
  description String?
  isRequired  Boolean  @default(false) @map("is_required")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Versiones de esta plantilla
  versions AnnexVersion[]

  @@map("annex_templates")
}

/// Versión específica de una plantilla de anexo
/// Una vez publicada, NO se modifica (inmutabilidad histórica)
model AnnexVersion {
  id               String   @id @default(cuid())
  annexTemplateId  String   @map("annex_template_id")
  versionNumber    Int      @map("version_number")
  description      String?
  isCurrentVersion Boolean  @default(false) @map("is_current_version")
  publishedAt      DateTime @default(now()) @map("published_at")
  createdAt        DateTime @default(now()) @map("created_at")

  annexTemplate AnnexTemplate @relation(fields: [annexTemplateId], references: [id])

  // Campos de esta versión del anexo
  fields AnnexField[]

  // Investigaciones que usan esta versión
  investigationAnnexes InvestigationAnnex[]

  @@unique([annexTemplateId, versionNumber])
  @@map("annex_versions")
}

/// Campo individual dentro de una versión de anexo
model AnnexField {
  id             String         @id @default(cuid())
  annexVersionId String         @map("annex_version_id")
  fieldKey       String         @map("field_key")   // identificador único del campo
  label          String
  fieldType      AnnexFieldType @map("field_type")
  isRequired     Boolean        @default(false) @map("is_required")
  helpText       String?        @map("help_text")
  order          Int            @default(0)
  options        Json?          // opciones para checklist u otros tipos selectivos
  createdAt      DateTime       @default(now()) @map("created_at")

  annexVersion AnnexVersion @relation(fields: [annexVersionId], references: [id])
  answers      AnnexAnswer[]

  @@unique([annexVersionId, fieldKey])
  @@map("annex_fields")
}

/// Relación entre una investigación y la versión del anexo que usa
/// Preserva la versión exacta al momento de uso
model InvestigationAnnex {
  id              String   @id @default(cuid())
  investigationId String   @map("investigation_id")
  annexVersionId  String   @map("annex_version_id")
  submittedAt     DateTime? @map("submitted_at")
  createdAt       DateTime @default(now()) @map("created_at")

  investigation Investigation @relation(fields: [investigationId], references: [id])
  annexVersion  AnnexVersion  @relation(fields: [annexVersionId], references: [id])

  // Respuestas del investigador
  answers AnnexAnswer[]

  @@unique([investigationId, annexVersionId])
  @@map("investigation_annexes")
}

/// Respuesta del investigador a un campo de un anexo
model AnnexAnswer {
  id                   String   @id @default(cuid())
  investigationAnnexId String   @map("investigation_annex_id")
  annexFieldId         String   @map("annex_field_id")
  value                String?  // valor de texto o selección
  jsonValue            Json?    @map("json_value") // para respuestas complejas (checklist múltiple)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  investigationAnnex InvestigationAnnex @relation(fields: [investigationAnnexId], references: [id])
  annexField         AnnexField         @relation(fields: [annexFieldId], references: [id])

  @@unique([investigationAnnexId, annexFieldId])
  @@map("annex_answers")
}

// ============================================================
// 5. ESTRATIFICACIÓN DE RIESGO
// ============================================================

/// Proceso de estratificación de riesgo
/// Puede haber múltiples por investigación (historial de reestratificaciones)
model RiskAssessment {
  id              String              @id @default(cuid())
  investigationId String              @map("investigation_id")
  status          RiskAssessmentStatus @default(ACTIVE)
  riskLevel       RiskLevel?          @map("risk_level") // se define cuando se completa
  justification   String?             // justificación del nivel de riesgo
  createdById     String              @map("created_by_id") // admin que la creó
  replacedById    String?             @map("replaced_by_id") // siguiente estratificación si fue reemplazada
  createdAt       DateTime            @default(now()) @map("created_at")
  completedAt     DateTime?           @map("completed_at")

  investigation Investigation @relation(fields: [investigationId], references: [id])
  createdBy     User          @relation("RiskAssessmentCreator", fields: [createdById], references: [id])

  // Miembros CEISH internos que participan en esta estratificación
  members RiskAssessmentMember[]

  // Proceso de evaluación generado a partir de esta estratificación
  evaluationProcess EvaluationProcess?

  @@map("risk_assessments")
}

/// Miembro CEISH interno asignado a una estratificación
model RiskAssessmentMember {
  id               String   @id @default(cuid())
  riskAssessmentId String   @map("risk_assessment_id")
  memberId         String   @map("member_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")

  riskAssessment RiskAssessment @relation(fields: [riskAssessmentId], references: [id])
  member         User           @relation(fields: [memberId], references: [id])

  @@unique([riskAssessmentId, memberId])
  @@map("risk_assessment_members")
}

// ============================================================
// 6. PROCESO DE EVALUACIÓN, ASIGNACIONES Y CONFLICTOS
// ============================================================

/// Proceso de evaluación asociado a una investigación
/// Existe uno por investigación (o por ciclo de evaluación si se reabre)
model EvaluationProcess {
  id               String                 @id @default(cuid())
  investigationId  String                 @unique @map("investigation_id")
  riskAssessmentId String                 @unique @map("risk_assessment_id")
  status           EvaluationProcessStatus @default(CREATED)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  investigation  Investigation  @relation(fields: [investigationId], references: [id])
  riskAssessment RiskAssessment @relation(fields: [riskAssessmentId], references: [id])

  // Asignaciones de evaluadores (incluye historial de removidos por conflicto)
  assignments EvaluationAssignment[]

  // Evaluaciones individuales
  evaluations Evaluation[]

  // Ciclos de corrección
  correctionRounds CorrectionRound[]

  @@map("evaluation_processes")
}

/// Asignación de un evaluador a un proceso de evaluación
/// El historial NUNCA se elimina; los removidos quedan con status REMOVED
model EvaluationAssignment {
  id                  String                    @id @default(cuid())
  evaluationProcessId String                    @map("evaluation_process_id")
  memberId            String                    @map("member_id")
  status              EvaluationAssignmentStatus @default(PENDING)
  assignedAt          DateTime                  @default(now()) @map("assigned_at")
  removedAt           DateTime?                 @map("removed_at")
  removalReason       String?                   @map("removal_reason")

  evaluationProcess EvaluationProcess @relation(fields: [evaluationProcessId], references: [id])
  member            User              @relation(fields: [memberId], references: [id])

  // Declaraciones de conflicto de este evaluador en este proceso
  conflictDeclarations ConflictDeclaration[]

  @@map("evaluation_assignments")
}

/// Declaración de conflicto de interés de un evaluador
/// Historial inmutable: cada declaración (incluyendo las negativas) queda registrada
model ConflictDeclaration {
  id                     String   @id @default(cuid())
  evaluationAssignmentId String   @map("evaluation_assignment_id")
  hasConflict            Boolean  @map("has_conflict")
  reason                 String?  // obligatorio si hasConflict = true
  declaredAt             DateTime @default(now()) @map("declared_at")

  evaluationAssignment EvaluationAssignment @relation(fields: [evaluationAssignmentId], references: [id])

  // Documento adjunto (Anexo 23)
  document Document?

  @@map("conflict_declarations")
}

// ============================================================
// 7. EVALUACIONES
// ============================================================

/// Evaluación individual realizada por un evaluador
/// Cada evaluador genera su propia evaluación dentro del proceso
model Evaluation {
  id                  String           @id @default(cuid())
  evaluationProcessId String           @map("evaluation_process_id")
  evaluatorId         String           @map("evaluator_id")
  status              EvaluationStatus @default(CREATED)
  summary             String?          // resumen del evaluador
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  completedAt         DateTime?        @map("completed_at")

  evaluationProcess EvaluationProcess @relation(fields: [evaluationProcessId], references: [id])
  evaluator         User              @relation(fields: [evaluatorId], references: [id])

  // Respuestas a criterios de evaluación
  criteriaResponses EvaluationCriteriaResponse[]

  // Observaciones generadas en esta evaluación
  observations Observation[]

  @@map("evaluations")
}

/// Respuesta de un evaluador a un criterio del anexo de evaluación
model EvaluationCriteriaResponse {
  id           String   @id @default(cuid())
  evaluationId String   @map("evaluation_id")
  criterionKey String   @map("criterion_key") // referencia al campo del anexo
  response     String   // "CUMPLE", "NO_CUMPLE", "NO_APLICA", o texto libre
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  @@unique([evaluationId, criterionKey])
  @@map("evaluation_criteria_responses")
}

// ============================================================
// 8. OBSERVACIONES Y CORRECCIONES
// ============================================================

/// Observación generada por un evaluador
model Observation {
  id           String   @id @default(cuid())
  evaluationId String   @map("evaluation_id")
  description  String
  section      String?  // sección del documento donde aplica
  isResolved   Boolean  @default(false) @map("is_resolved")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  // Respuestas del investigador a esta observación
  responses ObservationResponse[]

  @@map("observations")
}

/// Respuesta del investigador a una observación específica
model ObservationResponse {
  id              String   @id @default(cuid())
  observationId   String   @map("observation_id")
  correctionRound Int      @map("correction_round") // número de ciclo
  response        String
  createdAt       DateTime @default(now()) @map("created_at")

  observation Observation @relation(fields: [observationId], references: [id])

  @@map("observation_responses")
}

/// Ciclo de corrección del investigador
/// El historial es inmutable: cada ciclo queda registrado aunque se abran nuevos
model CorrectionRound {
  id                  String               @id @default(cuid())
  evaluationProcessId String               @map("evaluation_process_id")
  roundNumber         Int                  @map("round_number") // 1, 2, 3...
  status              CorrectionRoundStatus @default(OPEN)
  deadline            DateTime             // fecha límite para responder
  openedAt            DateTime             @default(now()) @map("opened_at")
  submittedAt         DateTime?            @map("submitted_at")
  closedAt            DateTime?            @map("closed_at")
  notes               String?              // notas del admin al abrir el ciclo

  evaluationProcess EvaluationProcess @relation(fields: [evaluationProcessId], references: [id])

  // Documentos de corrección adjuntos
  documents Document[]

  @@unique([evaluationProcessId, roundNumber])
  @@map("correction_rounds")
}

// ============================================================
// 9. DOCUMENTOS
// ============================================================

/// Archivos almacenados en MinIO
/// Polimórfico: puede estar asociado a diferentes entidades
model Document {
  id                     String       @id @default(cuid())
  filename               String
  originalFilename       String       @map("original_filename")
  mimeType               String       @map("mime_type")
  sizeBytes              Int          @map("size_bytes")
  storagePath            String       @map("storage_path") // ruta en MinIO
  documentType           DocumentType @map("document_type")
  uploadedAt             DateTime     @default(now()) @map("uploaded_at")

  // Relaciones opcionales (solo una aplica por registro)
  investigationId        String?      @map("investigation_id")
  correctionRoundId      String?      @unique @map("correction_round_id")
  conflictDeclarationId  String?      @unique @map("conflict_declaration_id")

  investigation       Investigation?       @relation(fields: [investigationId], references: [id])
  correctionRound     CorrectionRound?     @relation(fields: [correctionRoundId], references: [id])
  conflictDeclaration ConflictDeclaration? @relation(fields: [conflictDeclarationId], references: [id])

  @@map("documents")
}

// ============================================================
// 10. AUDITORÍA / WORKFLOW EVENTS
// ============================================================

/// Registro inmutable de todos los eventos relevantes del sistema
/// Es el log de auditoría: quién hizo qué, cuándo, en qué entidad
model WorkflowEvent {
  id              String            @id @default(cuid())
  eventType       WorkflowEventType @map("event_type")
  actorId         String?           @map("actor_id")       // usuario que realizó la acción
  investigationId String?           @map("investigation_id")

  // Información del cambio
  entityType      String?           @map("entity_type")    // "investigation", "evaluation", etc.
  entityId        String?           @map("entity_id")
  previousStatus  String?           @map("previous_status")
  newStatus       String?           @map("new_status")
  metadata        Json?             // datos adicionales específicos del evento

  description     String?           // descripción legible del evento
  occurredAt      DateTime          @default(now()) @map("occurred_at")

  actor         User?          @relation(fields: [actorId], references: [id])
  investigation Investigation? @relation(fields: [investigationId], references: [id])

  @@map("workflow_events")
}
